<mxfile host="app.diagrams.net" modified="2026-10-13T12:00:00.000Z" agent="Antigravity" version="24.7.0">
  <diagram name="4. Diagrama de Secuencia E2E - Flujo BNPL 30 Dias" id="diag_secuencia">
    <mxGraphModel dx="1800" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- TITULO PRINCIPAL -->
        <mxCell id="titulo" value="&lt;b style=&quot;font-size:16px;&quot;&gt;Diagrama de Secuencia E2E: Flujo Integral Buy Now Pay Later (BNPL 30 Días sin Intereses)&lt;/b&gt;&lt;br&gt;SGO-Logic MegaStore Fase 3 — Evaluación de Scoring, Bifurcación Desacoplada y Notificación Reactiva" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="380" y="20" width="840" height="40" as="geometry"/>
        </mxCell>

        <!-- CABECERAS DE PARTICIPANTES -->
        <mxCell id="p_cli" value="&lt;b&gt;Cliente / React SPA&lt;/b&gt;&lt;br&gt;:3000 (Checkout &amp;amp; Tracking)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p_ord" value="&lt;b&gt;ordenes-service&lt;/b&gt;&lt;br&gt;:8081 (CreditoService / Scoring)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p_erp" value="&lt;b&gt;PostgreSQL &amp;amp; AS/400&lt;/b&gt;&lt;br&gt;Histórico ERP e Incidencias" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="540" y="80" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p_rmq" value="&lt;b&gt;RabbitMQ Broker&lt;/b&gt;&lt;br&gt;:5672 (Topic Exchange)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="780" y="80" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p_inv" value="&lt;b&gt;inventario-service&lt;/b&gt;&lt;br&gt;:8082 (Bloqueo Optimista)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1020" y="80" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p_pag" value="&lt;b&gt;pagos-service&lt;/b&gt;&lt;br&gt;:8083 (Bifurcación BNPL)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1260" y="80" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p_fac" value="&lt;b&gt;facturacion-service&lt;/b&gt;&lt;br&gt;:8084 (FEL SAT &amp;amp; ACL AS/400)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1500" y="80" width="180" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="p_not" value="&lt;b&gt;notificaciones-service&lt;/b&gt;&lt;br&gt;:8086 (Push SSE /stream)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1740" y="80" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- SECUENCIA DE PASOS: RECTANGULOS Y FLECHAS NUMERADAS -->

        <!-- PASO 1 -->
        <mxCell id="step1" value="&lt;b&gt;Paso 1: Inicia Checkout en React&lt;/b&gt;&lt;br&gt;El usuario revisa su carrito e ingresa datos de entrega" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="220" height="65" as="geometry"/>
        </mxCell>

        <!-- PASO 2 -->
        <mxCell id="step2" value="&lt;b&gt;Paso 2: Consulta Scoring BNPL&lt;/b&gt;&lt;br&gt;POST /api/credito/evaluar&lt;br&gt;Envía clienteId y monto total" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="240" width="220" height="65" as="geometry"/>
        </mxCell>

        <!-- PASO 3 -->
        <mxCell id="step3" value="&lt;b&gt;Paso 3: Evaluación Histórica ERP&lt;/b&gt;&lt;br&gt;Verifica mora en AS/400, órdenes previas&lt;br&gt;Calcula Score (&amp;gt;= 70) y cupo disponible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="520" y="300" width="240" height="65" as="geometry"/>
        </mxCell>

        <!-- PASO 4 -->
        <mxCell id="step4" value="&lt;b&gt;Paso 4: Respuesta Scoring (HTTP 200)&lt;/b&gt;&lt;br&gt;{ aprobado: true, limite: 5000, plazoDias: 30, tasaInteres: 0.0% }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="290" y="370" width="230" height="65" as="geometry"/>
        </mxCell>

        <!-- PASO 5 -->
        <mxCell id="step5" value="&lt;b&gt;Paso 5: Presenta Banner BNPL en UI&lt;/b&gt;&lt;br&gt;React despliega opción &quot;Crédito Propio MegaStore (30 días)&quot; y exime tarjeta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="240" height="65" as="geometry"/>
        </mxCell>

        <!-- PASO 6 -->
        <mxCell id="step6" value="&lt;b&gt;Paso 6: Cliente Confirma Orden&lt;/b&gt;&lt;br&gt;POST /api/ordenes con metodoPago=&quot;credito_propio&quot;&lt;br&gt;Sin intermediación de PayKlik" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="240" height="65" as="geometry"/>
        </mxCell>

        <!-- PASO 7 -->
        <mxCell id="step7" value="&lt;b&gt;Paso 7: Guarda Orden CREADA y Publica&lt;/b&gt;&lt;br&gt;Persiste en PostgreSQL &amp;amp; Emite evento:&lt;br&gt;routing key: &quot;orden.creada&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="400" y="580" width="270" height="65" as="geometry"/>
        </mxCell>

        <!-- PASO 8 -->
        <mxCell id="step8" value="&lt;b&gt;Paso 8: Reserva de Inventario&lt;/b&gt;&lt;br&gt;inventario-service aplica @Version (15 min)&lt;br&gt;Publica routing key: &quot;inventario.reservado&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="880" y="650" width="270" height="65" as="geometry"/>
        </mxCell>

        <!-- PASO 9 -->
        <mxCell id="step9" value="&lt;b&gt;Paso 9: Bifurcación Desacoplada BNPL&lt;/b&gt;&lt;br&gt;pagos-service omite PayKlik y Circuit Breaker&lt;br&gt;Asigna ref: &quot;BNPL-30D-*&quot; -&amp;gt; Publica &quot;pago.confirmado&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1200" y="720" width="300" height="65" as="geometry"/>
        </mxCell>

        <!-- PASO 10 -->
        <mxCell id="step10" value="&lt;b&gt;Paso 10: Facturación DTE FEL y ACL AS/400&lt;/b&gt;&lt;br&gt;Inyecta &amp;lt;CondicionPago Modalidad=&quot;BNPL&quot; PlazoDias=&quot;30&quot;&amp;gt;&lt;br&gt;Registra cuenta por cobrar en ERP y emite &quot;despacho.solicitado&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1440" y="790" width="320" height="70" as="geometry"/>
        </mxCell>

        <!-- PASO 11 -->
        <mxCell id="step11" value="&lt;b&gt;Paso 11: Guía Courier LogiExpress&lt;/b&gt;&lt;br&gt;logistica-service genera guía LEX-GT&lt;br&gt;Actualiza orden a &quot;EN_PREPARACION&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1440" y="880" width="280" height="65" as="geometry"/>
        </mxCell>

        <!-- PASO 12 -->
        <mxCell id="step12" value="&lt;b&gt;Paso 12: Push Reactivo SSE en Vivo&lt;/b&gt;&lt;br&gt;notificaciones-service consume eventos del bus&lt;br&gt;Transmite por SSE (/stream) al navegador del cliente" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="1680" y="960" width="290" height="65" as="geometry"/>
        </mxCell>

        <!-- PASO 13 -->
        <mxCell id="step13" value="&lt;b&gt;Paso 13: Confirmación y Seguimiento Omnicanal&lt;/b&gt;&lt;br&gt;React recibe push: Muestra comprobante con vencimiento a 30 días, factura FEL y timeline con tracking LEX-GT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="1040" width="380" height="70" as="geometry"/>
        </mxCell>

        <!-- FLECHAS CONECTANDO LA SECUENCIA PASO A PASO -->
        <mxCell id="f1_2" value="1 -&amp;gt; 2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;fontSize=10;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry"/>
